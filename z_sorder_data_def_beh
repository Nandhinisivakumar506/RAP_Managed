managed implementation in class zbp_sorder_data_def unique;
strict ( 2 );
with draft;

define behavior for z_sorder_data_def// alias order
persistent table zsorder
draft table zsorder_d  //ctrl + 1 using quick fix create draft table
lock master total etag LastChangedAt   //draft
authorization master ( instance )      //db
etag master LocLastChangedAt

{
  create;
  update;
  delete;

 field ( readonly )
       NetPrice,
       Status,
       CreatedBy,
       CreatedAt,
       LastChangedAt,
       LocLastChangedAt,
       LocLastChangedBy;

  field ( mandatory )
       OrderNumber,
       CustomerNumber,
       MaterialNumber,
       Plant,
       Quantity,
       UnitPrice,
       CurrencyCode,
       UOM;


  validation validateQuantity on save       // Quantity > 0
    { create; update; }

  validation validatePrice on save         // Unitprice > 0
    { create; update; }

 /*determination calculateNetPrice on save
    { field UnitPrice ; field Quantity;} */
     determination calculateNetPrice on modify
    { field UnitPrice ; field Quantity;}

//  determination setInitialStatus on save { field Status;}
 determination setInitialStatus on save { create; }

side effects {
    field Quantity affects field NetPrice;
    field UnitPrice affects field NetPrice;
  }

  action approve;
  action reject;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;   //perpare->validation(valid/invalid)->activtion.

   mapping for zsorder
  {
  // CDS Field             table field
    OrderNumber          = order_number;
    CustomerNumber       = customer_number;
    MaterialNumber       = material_number;
    Plant                = plant;
    Quantity             = quantity;
    UnitPrice            = unit_price;
    NetPrice             = net_price;
    Uom                  = uom;
    CurrencyCode         = currency_code;
    Status               = status;
    CreatedBy            = created_by;
    CreatedAt            = created_at;
    LastChangedAt        = last_changed_at;
    LocLastChangedAt     = loc_last_changed_at;
  }
}
